# Listic API Environment Variables
# Copy this file to .env and fill in the values

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/listic?sslmode=require

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=listic

# Google Imagen 3 (via Gemini API — get key at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# App
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
